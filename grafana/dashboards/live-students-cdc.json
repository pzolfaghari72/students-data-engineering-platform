    {
      "id": 4,
      "title": "Live CDC Events",
      "type": "stat",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "students-cdc"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "students-cdc"
          },
          "rawSql": "WITH batch_seals AS\n(\n    SELECT generation_id, batch_id, min(verified_at) AS sealed_at\n    FROM cdc_batch_commits\n    WHERE generation_id IN (SELECT generation_id FROM cdc_active_generation)\n    GROUP BY generation_id, batch_id\n),\nlive_events AS\n(\n    SELECT e.source_table AS source_table, e.source_key AS source_key,\n           e.source_version AS source_version, e.operation AS operation,\n           min(s.sealed_at) AS processed_at,\n           fromUnixTimestamp64Milli(toInt64(nullIf(argMin(e.source_time_ms,\n               tuple(s.sealed_at, e.kafka_topic, e.kafka_partition, e.kafka_offset)), 0)), 'UTC') AS event_at\n    FROM cdc_serving_records AS e\n    INNER JOIN batch_seals AS s ON e.generation_id = s.generation_id AND e.batch_id = s.batch_id\n    WHERE e.operation IN ('c', 'u', 'd')\n    GROUP BY e.source_table, e.source_key, e.source_version, e.operation\n)\nSELECT countIf(operation = 'c') AS INSERT,\n       countIf(operation = 'u') AS UPDATE,\n       countIf(operation = 'd') AS DELETE,\n       round(60000.0 * count() / nullIf(dateDiff('millisecond', $__fromTime_ms, $__toTime_ms), 0), 2)\n           AS `Events / min`\nFROM live_events\nWHERE $__timeFilter_ms(processed_at)\nHAVING (SELECT count() FROM cdc_active_generation) > 0",
          "queryType": "table",
          "format": 1,
          "editorType": "sql"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No active CDC publication",
          "unit": "locale",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "INSERT"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Insert"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
