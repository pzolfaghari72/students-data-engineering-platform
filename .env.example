# Template only: copy to .env; Docker Compose does not load this file automatically.
# Keep real credentials only in the ignored .env file. Never commit or share .env.
# `make init` fills empty or GENERATE_ secret values in .env and preserves set values.

# -----------------------------------------------------
# PROJECT
# -----------------------------------------------------
# Compose project identity and timezone used by containers and scheduled jobs.
PROJECT_NAME=students-data-engineering-platform
TIMEZONE=UTC

# -----------------------------------------------------
# SQL SERVER SOURCE
# -----------------------------------------------------
# Source for the initial batch snapshot and Debezium CDC. Ask the DBA to
# provision this login and required permissions. Its password is not generated.
SOURCE_DB_HOST=CHANGE_ME_SOURCE_DB_HOST
SOURCE_DB_PORT=1433
SOURCE_DB_NAME=Students
SOURCE_DB_SCHEMA=dbo
SOURCE_DB_USER=CHANGE_ME_SOURCE_DB_USER
SOURCE_DB_PASSWORD=CHANGE_ME_SOURCE_DB_PASSWORD
SOURCE_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Encryption stays enabled. Trusting the server certificate bypasses validation;
# prefer `no` when SQL Server presents a trusted certificate.
SOURCE_DB_ENCRYPT=yes
SOURCE_DB_TRUST_SERVER_CERTIFICATE=yes
SOURCE_DB_CONNECTION_TIMEOUT=30
# The batch extract uses one SNAPSHOT isolation transaction across its tables.
SOURCE_DB_SNAPSHOT_ISOLATION=SNAPSHOT

# -----------------------------------------------------
# POSTGRESQL: INTERNAL ENDPOINT AND DATABASE ROLES
# -----------------------------------------------------
# Docker-network endpoint used by PostgreSQL clients inside containers.
POSTGRES_HOST=postgres
POSTGRES_CONTAINER_PORT=5432

# Bootstrap/admin role creates the application databases and roles.
POSTGRES_BOOTSTRAP_DB=postgres
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=GENERATE_POSTGRES_ADMIN_PASSWORD
# Raw staging database used by batch ingestion and CDC event persistence.
STAGING_DB_NAME=students_staging
STAGING_DB_USER=postgres_user
STAGING_DB_PASSWORD=GENERATE_STAGING_DB_PASSWORD
# JDBC driver Spark uses for PostgreSQL.
STAGING_JDBC_DRIVER=org.postgresql.Driver

# -----------------------------------------------------
# AIRFLOW: METADATA DATABASE, UI, AND SECURITY
# -----------------------------------------------------
# Airflow metadata uses a separate PostgreSQL database role from staging.
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=GENERATE_AIRFLOW_DB_PASSWORD
# Linux owner ID for files mounted into Airflow containers.
AIRFLOW_UID=1000
# Initial web UI administrator account.
AIRFLOW_ADMIN_USER=airflow_admin
AIRFLOW_ADMIN_PASSWORD=GENERATE_AIRFLOW_ADMIN_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.com
# Generated signing/encryption keys. Preserve them; changing Fernet can make
# existing encrypted Airflow metadata unreadable.
AIRFLOW_JWT_SECRET=GENERATE_AIRFLOW_JWT_SECRET
AIRFLOW__CORE__FERNET_KEY=GENERATE_AIRFLOW_FERNET_KEY
AIRFLOW__API__SECRET_KEY=GENERATE_AIRFLOW_API_SECRET
AIRFLOW_API_SERVER_URL=http://airflow-api-server:8080/execution/
# -----------------------------------------------------
# CLICKHOUSE: WAREHOUSE AND SERVICE ENDPOINTS
# -----------------------------------------------------
# Admin credentials are for initialization; Spark uses the warehouse role below.
CLICKHOUSE_ADMIN_USER=clickhouse_admin
CLICKHOUSE_ADMIN_PASSWORD=GENERATE_CLICKHOUSE_ADMIN_PASSWORD
CLICKHOUSE_HOST=clickhouse
# Internal container ports: HTTP/JDBC and native client.
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
# Analytical database and Spark writer credentials/driver.
WAREHOUSE_DB_NAME=students_warehouse
WAREHOUSE_DB_USER=clickhouse_user
WAREHOUSE_DB_PASSWORD=GENERATE_WAREHOUSE_DB_PASSWORD
WAREHOUSE_JDBC_DRIVER=com.clickhouse.jdbc.ClickHouseDriver
# Stable key for pseudonymizing student IDs. Do not rotate after loading data
# unless changing pseudonyms across snapshots is intended.
STUDENT_ID_HMAC_KEY=GENERATE_STUDENT_ID_HMAC_KEY

# -----------------------------------------------------
# GRAFANA BUSINESS DASHBOARDS
# -----------------------------------------------------
# Grafana serves ClickHouse-backed student KPIs; infrastructure monitoring is
# intentionally not included. These values configure the web administrator and UI port.
GRAFANA_ADMIN_USER=grafana_admin
GRAFANA_ADMIN_PASSWORD=GENERATE_GRAFANA_ADMIN_PASSWORD
# Read-only ClickHouse account used by Grafana's warehouse datasource.
GRAFANA_DB_USER=grafana_user
GRAFANA_DB_PASSWORD=GENERATE_GRAFANA_DB_PASSWORD

# -----------------------------------------------------
# KAFKA BROKER
# -----------------------------------------------------
# Internal listener is for containers; controller is for KRaft; external listener
# is published to the host. The advertised host must be reachable by host clients.
KAFKA_HOST=kafka
KAFKA_INTERNAL_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_EXTERNAL_PORT=9094
KAFKA_EXTERNAL_ADVERTISED_HOST=localhost
# Topic defaults, retention period in milliseconds, and broker JVM memory.
KAFKA_NUM_PARTITIONS=1
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
KAFKA_TOPIC_RETENTION_MS=604800000

# -----------------------------------------------------
# KAFKA CONNECT AND DEBEZIUM
# -----------------------------------------------------
# Connect REST endpoint and internal JMX endpoint. Spark reads Debezium snapshot
# completion from JMX during bootstrap; it is not an exporter service/dashboard.
CONNECT_HOST=connect
CONNECT_INTERNAL_PORT=8083
CONNECT_METRICS_PORT=9404
CONNECT_HEAP_OPTS=-Xms512m -Xmx768m
# Maximum wait used by the connector registration helper.
CONNECTOR_HEALTH_TIMEOUT_SECONDS=120
# SQL Server connector identity, topic prefix, schema-history topic, and snapshot mode.
DEBEZIUM_CONNECTOR_NAME=students-sqlserver
DEBEZIUM_TOPIC_PREFIX=students
DEBEZIUM_SCHEMA_HISTORY_TOPIC=schema-history.students
DEBEZIUM_SNAPSHOT_MODE=initial

# -----------------------------------------------------
# AIRFLOW INTERNAL API
# -----------------------------------------------------
# Container-to-container URL; this is not the host-published Airflow UI address.
AIRFLOW_API_SERVER_URL=http://airflow-api-server:8080/execution/

# -----------------------------------------------------
# LEGACY AIRFLOW CDC TASK
# -----------------------------------------------------
# Bounds one finite task run; these do not control Spark's streaming lifetime.
CDC_MAX_RECORDS=5000
CDC_MAX_SECONDS=45

# -----------------------------------------------------
# SPARK STRUCTURED STREAMING
# -----------------------------------------------------
# Independent long-running Compose service, not an Airflow task.
STREAMING_APP_NAME=StudentsCdcStreaming
STREAMING_QUERY_NAME=students-cdc
# Stored in a persistent Docker volume. Do not delete it to reset the query.
STREAMING_CHECKPOINT_DIR=/opt/spark/checkpoints/students-cdc
# Bound Kafka input per micro-batch and name the Kafka consumer group.
STREAMING_MAX_OFFSETS_PER_TRIGGER=1000
STREAMING_KAFKA_GROUP_ID=students-cdc-stream
# Maximum row batch sent to the ClickHouse warehouse.
WAREHOUSE_WRITE_BATCH_SIZE=1000
