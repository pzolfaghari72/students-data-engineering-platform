# Copy to .env or run make init. Use local settings and keep the real file private.
# make init generates local passwords and signing keys for GENERATE_* placeholders.
PROJECT_NAME=students-data-engineering-platform
TIMEZONE=UTC

# External SQL Server. Ask the DBA for the endpoint and read-only access.
SOURCE_DB_HOST=CHANGE_ME_SOURCE_DB_HOST
SOURCE_DB_PORT=1433
SOURCE_DB_NAME=Students
SOURCE_DB_SCHEMA=dbo
SOURCE_DB_USER=CHANGE_ME_SOURCE_DB_USER
SOURCE_DB_PASSWORD=CHANGE_ME_SOURCE_DB_PASSWORD
SOURCE_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SOURCE_DB_ENCRYPT=yes
SOURCE_DB_TRUST_SERVER_CERTIFICATE=no
SOURCE_DB_CONNECTION_TIMEOUT=30
SOURCE_DB_SNAPSHOT_ISOLATION=SNAPSHOT
# Optional connector-specific reader. Blank values reuse the source login.
SOURCE_CDC_USER=
SOURCE_CDC_PASSWORD=

# PostgreSQL database roles and internal/host endpoints.
POSTGRES_HOST=postgres
POSTGRES_CONTAINER_PORT=5432
POSTGRES_HOST_PORT=15433
POSTGRES_BOOTSTRAP_DB=postgres
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=GENERATE_POSTGRES_PASSWORD
STAGING_DB_NAME=students_staging
STAGING_DB_USER=postgres_user
STAGING_DB_PASSWORD=GENERATE_STAGING_PASSWORD
STAGING_JDBC_DRIVER=org.postgresql.Driver
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow_user
AIRFLOW_DB_PASSWORD=GENERATE_AIRFLOW_DB_PASSWORD

# Airflow
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=airflow_admin
AIRFLOW_ADMIN_PASSWORD=GENERATE_AIRFLOW_ADMIN_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW__CORE__FERNET_KEY=GENERATE_FERNET_KEY
AIRFLOW_JWT_SECRET=GENERATE_AIRFLOW_JWT_SECRET
AIRFLOW__API__SECRET_KEY=GENERATE_AIRFLOW_API_SECRET
AIRFLOW_API_SERVER_URL=http://airflow-api-server:8080/execution/
AIRFLOW_HOST_PORT=18080
# Leave blank for operator-triggered snapshots, or supply an Airflow cron schedule.
BATCH_SNAPSHOT_SCHEDULE=
SPARK_BATCH_MASTER=local[2]
SPARK_BATCH_DRIVER_MEMORY=768m
SPARK_BATCH_SHUFFLE_PARTITIONS=2
SPARK_BATCH_READ_PARTITIONS=2
SPARK_BATCH_FETCH_SIZE=10000
SPARK_BATCH_WRITE_SIZE=10000

# ClickHouse. Batch and CDC writers have distinct databases and users.
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_HOST_HTTP_PORT=18123
CLICKHOUSE_HOST_NATIVE_PORT=19000
CLICKHOUSE_ADMIN_USER=clickhouse_admin
CLICKHOUSE_ADMIN_PASSWORD=GENERATE_CLICKHOUSE_PASSWORD
WAREHOUSE_DB_NAME=students_warehouse
WAREHOUSE_DB_USER=clickhouse_user
WAREHOUSE_DB_PASSWORD=GENERATE_WAREHOUSE_PASSWORD
WAREHOUSE_JDBC_DRIVER=com.clickhouse.jdbc.ClickHouseDriver
STUDENT_ID_HMAC_KEY=GENERATE_STUDENT_HMAC_KEY
CDC_DB_NAME=students_cdc
CDC_DB_USER=students_cdc_writer
CDC_DB_PASSWORD=GENERATE_CDC_PASSWORD
# Allow dashboard aggregations to spill to disk on a small local host.
CLICKHOUSE_DASHBOARD_GROUP_BY_BYTES=134217728

# Grafana uses the restricted ClickHouse reader for both datasources.
GRAFANA_ADMIN_USER=grafana_admin
GRAFANA_ADMIN_PASSWORD=GENERATE_GRAFANA_ADMIN_PASSWORD
GRAFANA_DB_USER=grafana_user
GRAFANA_DB_PASSWORD=GENERATE_GRAFANA_DB_PASSWORD
GRAFANA_HOST_PORT=13000

# Kafka and Kafka Connect. Preserve these identities with existing Kafka volumes.
KAFKA_HOST=kafka
KAFKA_INTERNAL_PORT=9092
KAFKA_CONTROLLER_PORT=9093
KAFKA_EXTERNAL_PORT=9094
KAFKA_HOST_PORT=19094
KAFKA_EXTERNAL_ADVERTISED_HOST=localhost
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_NUM_PARTITIONS=1
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m
KAFKA_TOPIC_RETENTION_MS=604800000
CONNECT_HOST=connect
CONNECT_INTERNAL_PORT=8083
CONNECT_HOST_PORT=18083
CONNECT_METRICS_PORT=9404
CONNECT_HEAP_OPTS=-Xms512m -Xmx768m
CONNECT_GROUP_ID=1
CONNECT_CONFIG_STORAGE_TOPIC=connect_configs
CONNECT_OFFSET_STORAGE_TOPIC=connect_offsets
CONNECT_STATUS_STORAGE_TOPIC=connect_statuses
CONNECTOR_HEALTH_TIMEOUT_SECONDS=120

# Debezium. Use a distinct connector, topic namespace and history for a fresh baseline.
DEBEZIUM_CONNECTOR_NAME=students-sqlserver
DEBEZIUM_TOPIC_PREFIX=students
DEBEZIUM_SCHEMA_HISTORY_TOPIC=schema-history.students
DEBEZIUM_SNAPSHOT_MODE=initial
DEBEZIUM_SNAPSHOT_ISOLATION_MODE=snapshot

# Spark. Preserve the paired generation ID and checkpoint across routine restarts.
STREAMING_APP_NAME=StudentsCdcStreaming
STREAMING_QUERY_NAME=students-cdc
STREAMING_GENERATION_ID=students-cdc-v1
CDC_CHECKPOINT_DIR=/opt/spark/checkpoints/students-cdc-warehouse
STREAMING_MAX_OFFSETS_PER_TRIGGER=10000
STREAMING_TRIGGER_INTERVAL=5 seconds
STREAMING_BOOTSTRAP_TIMEOUT_SECONDS=3600
SPARK_STREAM_MASTER=local[2]
SPARK_STREAM_DRIVER_MEMORY=768m
SPARK_STREAM_SHUFFLE_PARTITIONS=2
SPARK_STREAM_MEMORY_LIMIT=1536m
SPARK_STREAM_CPUS=1.5
